# ===== 广告网络开关 =====
# none = 不加载广告；adsense = 海外 Google AdSense；baidu = 国内百度联盟
NEXT_PUBLIC_AD_NETWORK=none

# ===== Google AdSense（海外）=====
# 你的发布商 ID，形如 ca-pub-1234567890
NEXT_PUBLIC_ADSENSE_ID=
# 各广告位的「广告单元 ID」（在 AdSense 后台创建展示广告后获得，分别填入 header / infeed / footer）
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# ===== 百度联盟（国内）=====
# 你的联盟 ID
NEXT_PUBLIC_BAIDU_UNION_ID=
NEXT_PUBLIC_BAIDU_SLOT_HEADER=
NEXT_PUBLIC_BAIDU_SLOT_INFEED=
NEXT_PUBLIC_BAIDU_SLOT_FOOTER=

# 站点正式域名（用于 canonical / sitemap，海外与国内可不同）
NEXT_PUBLIC_SITE_URL=https://offlinetoolhub.com

# ===== 流量统计 =====
# Cloudflare Dashboard -> Web Analytics -> Manage site -> JS Snippet 中的 token
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
